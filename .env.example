# ---- LLM (OpenAI-compatible chat/completions) ----
# AgentRouter multi-LLM gateway. Requires client-identity headers via LLM_EXTRA_HEADERS.
LLM_BASE_URL=https://agentrouter.org/v1
LLM_API_KEY=sk-your-key-here
LLM_CHEAP_MODEL=deepseek-v4-flash
LLM_STRONG_MODEL=deepseek-v4-flash
# Gateways that gate on client identity need extra headers.
LLM_EXTRA_HEADERS={"User-Agent":"your-ua","x-app":"cli"}
# Optional sponsor alt gateway
LLM_HACKATHON_BASE_URL=

# ---- Bitget Agent Hub (paper trading only — no live money) ----
BITGET_API_KEY=your-bitget-api-key
BITGET_API_SECRET=your-bitget-api-secret
BITGET_PASSPHRASE=your-bitget-passphrase
BITGET_PAPER_TRADING=true
BITGET_KEY_TYPE=agent
BITGET_EXECUTOR_MODE=dry-run

# ---- 0G Compute Router (Phase 0 engine). Key value goes in .env.local only — never commit it. ----
LLM_BASE_URL=https://router-api.0g.ai/v1
LLM_STRONG_MODEL=deepseek-v4-pro
LLM_CHEAP_MODEL=deepseek-v4-pro
LLM_API_KEY=

# ---- Deployment ----
# Set to the deployed origin so the server-side /proof fetch resolves.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
